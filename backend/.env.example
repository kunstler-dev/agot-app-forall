# Local development: copy to backend/.env
# With DEV_AUTH=1 the app opens in a regular browser (http://localhost:5173/?dev=<id>)
DEV_AUTH=1
AUTO_CREATE_SCHEMA=1
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# Tenant and content (default: the bundled demo world in ../demo)
# TENANT_FILE=../demo/tenant.json
# CONTENT_DIR=../demo/content

# Optional overrides of tenant.json
# REQUIRED_CHANNEL=@your_channel
# CHANNEL_URL=https://t.me/your_channel
# TIMEZONE=Europe/Moscow

# Telegram (use a TEST bot locally): off | polling | webhook
BOT_TOKEN=
BOT_MODE=off
WEBAPP_URL=
WEBHOOK_SECRET=
ADMIN_IDS=1
